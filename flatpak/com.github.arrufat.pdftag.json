{
  "id" : "com.github.arrufat.pdftag",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "46",
  "sdk" : "org.gnome.Sdk",
  "command" : "pdftag",
  "modules" : [
    {
      "name" : "poppler",
      "buildsystem" : "cmake",
      "config-opts" : [
        "-DENABLE_LIBOPENJPEG:STRING=none",
        "-DENABLE_GLIB=ON",
        "-DENABLE_QT5=OFF",
        "-DENABLE_QT6=OFF",
        "-DENABLE_UTILS=OFF",
        "-DENABLE_CPP=OFF",
        "-DENABLE_BOOST=OFF"
      ],
      "sources" : [
        {
          "url" : "https://gitlab.freedesktop.org/poppler/poppler.git",
          "type" : "git",
          "tag" : "poppler-25.01.0"
        }
      ]
    },
    {
      "name" : "pdftag",
      "buildsystem" : "meson",
      "sources" : [
        {
          "url" : "https://github.com/arrufat/pdftag",
          "type" : "git"
        }
      ]
    }
  ],
  "cleanup" : [
    "/include",
    "/lib/pkgconfig"
  ],
  "finish-args" : [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--filesystem=home"
  ]
}
